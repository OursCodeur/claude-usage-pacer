{
  "manifest_version": 3,
  "name": "Claude Usage Pacer",
  "version": "1.0.1",
  "description": "Marks how much of the week has elapsed on Claude's weekly usage bar, so you can pace usage and avoid running out before it resets.",
  "homepage_url": "https://github.com/OursCodeur/claude-usage-pacer",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-usage-pacer@ourscodeur",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
